# Install (per-user):
#   install -Dm644 deploy/systemd/user/pixypilot.service ~/.config/systemd/user/pixypilot.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now pixypilot.service
# ExecStart assumes the repo stays at the path below; update it if the
# checkout moves.
[Unit]
Description=PixyPilot - EMEET PIXY control backend
After=default.target

[Service]
Type=simple
ExecStart=%h/AI-Workspace/research/emeet-pixy/PixyPilot/backend/.venv/bin/pixypilot-api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
