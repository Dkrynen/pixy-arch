# Pixy Arch backend as a systemd user service.
# Install with tools/install-service.sh, which fills in @ROOT@ with the path
# of your checkout. Re-run it if you move the checkout.
[Unit]
Description=Pixy Arch - EMEET PIXY control deck backend
After=default.target pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart="@ROOT@/backend/.venv/bin/pixypilot-api"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
